# Copie para .env e preencha. O .env nunca é versionado.

# Postgres do docker compose (infra/docker-compose.yml).
# Se a 5432 já estiver ocupada na sua máquina, troque a porta nas duas linhas, pelo mesmo número.
ARCO_PG_PORTA=5432
DATABASE_URL=postgresql+psycopg://arco:arco@localhost:5432/arco

# Origens de navegador que podem chamar a API, separadas por vírgula. O padrão é a interface local.
#
# É a origem da **página**, nunca a da API: quem entra aqui é o endereço de onde o `web` é
# servido. Com o front publicado, some a URL dele, ex.: https://main.xxxx.amplifyapp.com
#
# `*` libera qualquer origem. Vale enquanto `make tunel` durar, porque a URL sorteada morre com
# o terminal. **Com URL fixa, não:** a API não tem autenticação, e `*` permanente
# deixa qualquer página da web ler e gravar simulações neste banco pelo navegador de quem a
# visita. Liste as origens.
#
# A API só lê isto na subida: mudou, reinicie.
CORS_ORIGENS=http://localhost:5173,http://127.0.0.1:5173

# Túnel de URL fixa (`make tunel-fixo` e `make servidor`). O túnel é criado no painel da
# Cloudflare, que devolve um token; guarde-o num arquivo só seu, fora do repositório.
# Padrão: ~/.cloudflared/token-arco. O passo a passo do painel está em infra/README.md.
TUNEL_TOKEN_ARQUIVO=
# Só para a mensagem que o script imprime ao subir. Não configura nada.
PUBLICO=

# Depósito das releases de snapshot, no formato dono/repositorio do GitHub
SNAPSHOT_REPO=Hackathon-IA-2026/solucoes-grupo-08

# Token do GitHub, para `make snapshot` baixar as releases. **Obrigatório enquanto o repositório
# for privado, que é o caso hoje.** `GH_TOKEN` também serve, que é o nome usado pelo gh.
# Com o gh instalado:  printf '\nGITHUB_TOKEN=%s\n' "$(gh auth token)" >> .env
GITHUB_TOKEN=

# Chave do Google AI Studio, para o pacote ia/ (modelo gemini-3.8-flash).
# Usada por `arco-dados preparar --com-modelo`, que manda ao modelo os textos de restrição que a
# regra determinística não conseguiu ler, e pelo relatório da simulação, na API. Sem ela esses
# dois falham dizendo o que ficou faltando; o preparo sem a opção roda normalmente. IA não é
# acessório do produto: sem vínculo não há ranking.
GEMINI_API_KEY=

# Rastro das chamadas ao modelo (OpenTelemetry), no Langfuse Cloud, plano gratuito.
# As chaves saem do painel do projeto em https://cloud.langfuse.com. Sem elas o rastro vai para o
# console e nada quebra. LANGFUSE_BASE_URL só muda para outra região do Langfuse, ex.:
# https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# MCP do ARCO (`make agentes`, pacote agentes/). Roda na mesma máquina da API e fala com ela por
# HTTP. ARCO_MCP_PORTA é a que o túnel expõe num segundo hostname (infra/README.md);
# ARCO_PAINEL_URL é o endereço do painel, para o link Ver processamento que o chat mostra.
ARCO_API_URL=http://localhost:8000
ARCO_MCP_PORTA=8100
ARCO_PAINEL_URL=http://localhost:5173
# O mesmo processo, visto da API: ao criar uma exploração, a API o chama para pôr o explorador
# para rodar. Tem de apontar para a porta de ARCO_MCP_PORTA.
ARCO_AGENTES_URL=http://localhost:8100

# Só para o web/. Sem esta variável, o Vite faz proxy de /api para a API local em
# http://localhost:8000 (web/vite.config.ts). Para o web apontar direto para outra API
# (ex.: o túnel do Cloudflare de `make tunel`), defina a URL completa:
VITE_API_URL=
